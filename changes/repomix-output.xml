            } else if (collectionName === 'fees') {
              record = cleanRecord({
                autoId: safeStr(row, 'Auto ID') || ('FEE-' + String(seq).padStart(3, '0')),
                studentId: safeStr(row, 'Student Auto ID', 'Student ID', 'Auto ID'),
