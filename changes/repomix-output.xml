      { header: 'Calc Method', key: 'Calc Method', width: 16 },
      { header: 'Unpaid Leave Days', key: 'Unpaid Leave Days', width: 14 },
      { header: 'Half-Day Count', key: 'Half-Day Count', width: 12 },
