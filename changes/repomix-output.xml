              await addExpense(record);
            } else if (collectionName === 'employees') {
              record = cleanRecord({
                autoId: safeStr(row, 'Auto ID') || ('EMP-' + String(seq).padStart(3, '0')),
                name: safeStr(row, 'Name', 'Employee Name').toUpperCase(),
