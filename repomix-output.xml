  if (snap.empty) {
    const ref = await addDoc(collection(db, 'teacherSubjects'), { ...data, createdAt: Timestamp.now() });
    return ref.id;
  } else {
    await updateDoc(doc(db, 'teacherSubjects', snap.docs[0].id), data);
