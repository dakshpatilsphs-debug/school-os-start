                                >
                                  <FiDollarSign size={13} /> Pay ₹{Math.max(0, effSalary - ((e.monthDeduction?.[selectedDate.substring(0, 7)] ?? e.otherDeduction) || 0)).toLocaleString()}
                                </button>
                              )}
                            </td>
                            <td className="px-4 py-3">
                              <button
