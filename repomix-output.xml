            >
              <option value="">-- Select Employee --</option>
              {employees.filter(e => e.status === 'ACTIVE').sort((a, b) => a.name.localeCompare(b.name)).map(e => (
                <option key={e.id} value={e.autoId}>{e.name} — {e.role} ({e.autoId})</option>
